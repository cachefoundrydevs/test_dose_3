  connect \bank_write_resp_error \ans_err
  connect \bank_write_resp_non_cacheable \ans_nc
  connect \bank_write_resp_sub_id \ans_sub
  connect \bank_read_data_shared \ans_shared
  connect \bank_read_data_error \ans_err
  connect \bank_read_data_non_cacheable \ans_nc
  connect \bank_read_data_sub_id \ans_sub
end
