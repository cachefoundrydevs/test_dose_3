# Approved name changes of l1d_bank_order against golden/l1d_bank_order.v (format: flow/check_names.pl)
# iteration PF-I2 (2026-11-23): one-hot join counts, fill count and empty flag selected from precomputed values
+ DECL reg[LSU_PORTS:0]join_cnt_onehot
+ DECL reg[LSU_PORTS:0]rank_before_onehot[0:LSU_PORTS-1]
+ DECL reg[LSU_PORTS:0]join_run
+ DECL reg[ORDER_CNT_W-1:0]count_next_sel
+ DECL reg ring_empty_next
+ DECL reg[ORDER_CNT_W-1:0]count_candidate
+ DECL integer join_port_idx
+ DECL integer join_count_idx
+ DECL integer pop_value_idx
+ DECL reg candidate_selected
+ DECL input[ORDER_DEPTH-1:0]pointer_onehot
+ DECL input[LSU_PORTS:0]step_onehot
+ DECL integer step_idx
+ FOR for(step_idx=0;step_idx<=LSU_PORTS;step_idx=step_idx+1)
+ ALWAYS always @*
+ FOR for(join_port_idx=0;join_port_idx<LSU_PORTS;join_port_idx=join_port_idx+1)
+ FOR for(join_count_idx=0;join_count_idx<=LSU_PORTS;join_count_idx=join_count_idx+1)
+ FOR for(pop_value_idx=0;pop_value_idx<=1;pop_value_idx=pop_value_idx+1)
# iteration BO-1 (2026-11-23): fill count and empty flag as early select words AND-ORed with the decoded count (no adder)
+ DECL localparam COUNT_VALUES = 1 << ORDER_CNT_W
+ DECL reg[ORDER_CNT_W*COUNT_VALUES-1:0]count_bit_select
+ DECL reg[COUNT_VALUES-1:0]empty_select
+ DECL integer count_value_idx
+ DECL integer count_bit_idx
+ FOR for(count_value_idx=0;count_value_idx<COUNT_VALUES;count_value_idx=count_value_idx+1)
+ FOR for(count_bit_idx=0;count_bit_idx<ORDER_CNT_W;count_bit_idx=count_bit_idx+1)
# iteration BO-2 (2026-11-23): low count pair predecoded, next bit k from order_count[k:0] only, reset folded into the selects
+ DECL localparam COUNT_LOW_W = ORDER_CNT_W / 2
+ DECL localparam COUNT_LOW_VALUES = 1 << COUNT_LOW_W
+ DECL reg count_prefix_hit
+ FOR for(count_value_idx=0;count_value_idx<COUNT_LOW_VALUES;count_value_idx=count_value_idx+1)
# iteration BO-4 (2026-11-23): high count pair predecoded too; next count bits and the empty flag as
# low one-hot AND (high one-hot AND early select); count_hit_onehot removed (its "+ DECL" line and two count loops dropped)
# iteration BO-6 (2026-11-23): order_port write as AND-OR with the write pointer bit last (ranks from the join_run chain);
# low next-count bits from low_hit_onehot only (order_count[1:0] feed only the low decode)
+ DECL reg[LSU_PORTS-1:0]rank_used
+ DECL reg[LSU_PORTS*PORT_W-1:0]rank_port
+ DECL integer rank_idx
+ DECL integer place_rank_idx
+ FOR for(rank_idx=0;rank_idx<LSU_PORTS;rank_idx=rank_idx+1)
+ FOR for(place_rank_idx=0;place_rank_idx<LSU_PORTS;place_rank_idx=place_rank_idx+1)
# iteration BO-7 (2026-11-23): order_count[0] only in the last gate (Shannon split) of every next-count bit and of the
# empty flag; order_count[2:1] predecoded (mid_hit_onehot). Dropped with it: low_hit_onehot, high_hit_onehot,
# COUNT_HIGH_VALUES, high_part_select, high_value_idx and their loops (lines of BO-2 / BO-4 removed)
+ DECL reg[COUNT_LOW_VALUES-1:0]mid_hit_onehot
+ DECL reg next_if_bit0_clear
+ DECL reg next_if_bit0_set
+ FOR for(count_bit_idx=0;count_bit_idx<=ORDER_CNT_W;count_bit_idx=count_bit_idx+1)
+ FOR for(count_value_idx=0;count_value_idx<COUNT_VALUES/2;count_value_idx=count_value_idx+1)
