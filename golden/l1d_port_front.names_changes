# Approved name changes of l1d_port_front against golden/l1d_port_front.v (format: flow/check_names.pl)
# iteration PF-I1 (2026-11-23): rank adders and compare replaced by a one-hot lower-port count and 'at least k free' flags
# iteration PF-I3 (2026-11-23): stop_after as three precomputed answers selected by push / pop
# iteration PF-I4 (2026-11-23): skid FIFO fill level with the pop as the last select (POP_LAST)
+ DECL localparam SKID_POP_LAST = 1
- DECL reg[RANK_W-1:0]rank[0:NP-1]
+ DECL reg[NP:1]free_at_least
- DECL integer rk_l
+ DECL integer rk_k
+ FOR for(rk_k=1;rk_k<=NP;rk_k=rk_k+1)
- FOR for(rk_l=0;rk_l<rk_p;rk_l=rk_l+1)
+ DECL reg[SKID_CNT_W:0]used_if_push
+ DECL reg[SKID_CNT_W:0]used_if_pop
+ DECL reg stop_if_hold
+ DECL reg stop_if_push
+ DECL reg stop_if_pop
# iteration PF-I6 (2026-11-25): drain decided per port before the ring-head select (drain_port_ready / drain_alloc_port,
# drain_line_store dropped); alloc_here as threshold implications 'at least k lower eligible_if_empty -> at least k+1
# free' with ring_empty_q last (the PF-I1 rank_run chain, rank_onehot and the rk_k 0..NP-1 loop removed, their lines
# dropped); stop_after with pop as the last select
+ DECL wire[NB*NP-1:0]drain_port_ready
+ DECL wire[NB*NP-1:0]drain_alloc_port
+ DECL integer ones_in_pattern
+ DECL integer pattern_value
+ DECL integer pattern_bit
+ FOR for(pattern_bit=0;pattern_bit<NP;pattern_bit=pattern_bit+1)
+ DECL wire[NP-1:0]eligible_if_empty
+ DECL wire free_nonzero
+ DECL integer rk_pattern
+ DECL reg lower_at_least
+ FOR for(rk_k=1;rk_k<NP;rk_k=rk_k+1)
+ FOR for(rk_pattern=0;rk_pattern<(1<<NP);rk_pattern=rk_pattern+1)
- DECL reg drain_line_store
# iteration PF-I8 (2026-11-25): join thresholds of every port prefix for the ring (u_order.join_prefix_at_least), from
# the pins and the room rule in parallel (P - min(L, G) as threshold AND/OR), ring_empty_q as the last select
+ DECL reg[NP*NP-1:0]join_prefix_at_least
+ DECL reg pins_at_least
+ DECL reg pins_at_least_m
+ DECL reg eligible_at_least
+ DECL reg joins_if_empty
+ DECL integer jp_k
+ DECL integer jp_m
+ DECL integer jp_a
+ DECL integer jp_pattern
+ FOR for(jp_k=1;jp_k<=NP;jp_k=jp_k+1)
+ FOR for(jp_m=1;jp_m<=NP;jp_m=jp_m+1)
+ FOR for(jp_pattern=0;jp_pattern<(1<<NP);jp_pattern=jp_pattern+1)
+ FOR for(jp_a=0;jp_a<=jp_k-jp_m;jp_a=jp_a+1)
+ FOR for(jp_pattern=0;jp_pattern<(1<<NP);jp_pattern=jp_pattern+1)
# iteration PF-I10 (2026-11-25): room rule as alloc_if_empty with ring_empty_q ANDed last; port_allocated from
# alloc_if_ring_empty and the ring_empty_q of the pin's bank (the per-bank 'eligible' wire is no longer needed)
+ DECL wire[NB*NP-1:0]alloc_if_ring_empty
+ DECL reg[NP-1:0]alloc_if_empty
- DECL wire[NP-1:0]eligible
